<Window x:Class="DataGateWin.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{DynamicResource Install_WindowTitle}" Height="640" Width="1000" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource WindowBackgroundBrush}">
    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            CornerRadius="10"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F5F6F8"/>
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#111827"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#6B7280"/>
        <SolidColorBrush x:Key="BorderBrushStrong" Color="#D1D5DB"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#2563EB"/>
        <SolidColorBrush x:Key="AccentBrushHover" Color="#1D4ED8"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushStrong}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
        <Style TargetType="ProgressBar">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Background" Value="#E5E7EB"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentBrushHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource BorderBrushStrong}"
            BorderThickness="1"
            CornerRadius="10"
            Background="{DynamicResource WindowBackgroundBrush}"
            SnapsToDevicePixels="True">
        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,16" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Install_HeaderSubtitle}"
                           FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Name="StepTextBlock" Text=""
                           Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0"/>

                <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                            VerticalAlignment="Center" Margin="12,0,12,0" MinWidth="220">
                    <TextBlock Text="{DynamicResource Install_LanguageLabel}"
                               Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
                    <TextBlock Text="{DynamicResource Install_LanguageHint}"
                               Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Opacity="0.85"
                               TextWrapping="Wrap" MaxWidth="260" Margin="0,2,0,0"/>
                    <ComboBox Name="InstallerLanguageCombo" Margin="0,8,0,0" MinWidth="220" MaxWidth="320"
                              HorizontalAlignment="Left"
                              SelectionChanged="InstallerLanguageCombo_OnSelectionChanged"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="{DynamicResource Install_Appearance}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,12,0"/>
                    <RadioButton Name="LightThemeRadioButton" Content="{DynamicResource Install_ThemeLight}" GroupName="Theme"
                                 Margin="0,0,10,0" Checked="ThemeRadioButton_Checked"/>
                    <RadioButton Name="DarkThemeRadioButton" Content="{DynamicResource Install_ThemeDark}" GroupName="Theme"
                                 Checked="ThemeRadioButton_Checked"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="3" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Name="MinimizeButton" Content="—" Width="36" Height="28"
                            Click="MinimizeButton_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"/>
                    <Button Name="CloseButton" Content="×" Width="36" Height="28"
                            Click="CloseButton_Click" Style="{StaticResource SecondaryButton}"/>
                </StackPanel>
            </Grid>

        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrushStrong}"
                BorderThickness="1" CornerRadius="10" Padding="20">
            <Grid>
                <StackPanel Name="PolicyPanel" Visibility="Collapsed">
                    <TextBlock Text="{DynamicResource Install_LicenseTitle}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <Border BorderBrush="{DynamicResource BorderBrushStrong}" BorderThickness="1" CornerRadius="6" Padding="12"
                            Background="{DynamicResource WindowBackgroundBrush}">
                        <ScrollViewer Height="300" VerticalScrollBarVisibility="Auto">
                            <TextBlock TextWrapping="Wrap" Text="{DynamicResource Install_PolicyBody}"/>
                        </ScrollViewer>
                    </Border>
                    <CheckBox Name="PolicyCheckBox" Content="{DynamicResource Install_AcceptPolicy}" Margin="0,12,0,0"
                              Checked="PolicyCheckBox_Changed" Unchecked="PolicyCheckBox_Changed"/>
                </StackPanel>

                <StackPanel Name="PathPanel" Visibility="Collapsed">
                    <TextBlock Text="{DynamicResource Install_ChooseLocationTitle}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock Text="{DynamicResource Install_ChooseLocationHint}"
                               Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,12"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource Install_FolderLabel}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox Grid.Column="1" Name="InstallPathTextBox" Height="28"
                                 TextChanged="InstallPathTextBox_TextChanged"/>
                        <Button Grid.Column="2" Name="BrowseButton" Content="{DynamicResource Install_Browse}" Width="110" Height="28"
                                Margin="10,0,0,0" Click="BrowseButton_Click" Style="{StaticResource SecondaryButton}"/>
                    </Grid>

                    <TextBlock Text="{DynamicResource Install_ShortcutsTitle}" FontWeight="SemiBold" Margin="0,8,0,8"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,10"
                               Text="{DynamicResource Install_ShortcutsHint}"/>
                    <CheckBox Name="StartMenuShortcutCheckBox" Content="{DynamicResource Install_StartMenuShortcut}"
                              IsChecked="True" Margin="0,0,0,6"/>
                    <CheckBox Name="DesktopShortcutCheckBox" Content="{DynamicResource Install_DesktopShortcut}"
                              IsChecked="True"/>
                </StackPanel>

                <StackPanel Name="InstallPanel" Visibility="Collapsed">
                    <TextBlock Name="InstallTitleTextBlock" Text="" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Download URL:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox Grid.Column="1" Name="UrlTextBox" Height="28" IsReadOnly="True" Text=""/>
                    </Grid>

                    <TextBlock Text="{DynamicResource Install_Downloading}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ProgressBar Name="DownloadProgressBar" Height="22" Minimum="0" Maximum="100" Value="0" Margin="0,0,0,12"/>

                    <TextBlock Text="{DynamicResource Install_Installing}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ProgressBar Name="InstallProgressBar" Height="22" Minimum="0" Maximum="100" Value="0" Margin="0,0,0,12"/>

                    <TextBox Name="LogTextBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="12" Height="170"/>
                </StackPanel>

                <StackPanel Name="FinishPanel" Visibility="Collapsed">
                    <TextBlock Text="{DynamicResource Install_FinishTitle}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock Name="FinishStatusTextBlock" Text=""
                               TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <CheckBox Name="LaunchCheckBox" Content="{DynamicResource Install_LaunchNow}" IsChecked="True"/>
                </StackPanel>
            </Grid>
        </Border>

            <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Text="{DynamicResource Install_FooterCopyright}"/>
            <Button Grid.Column="1" Name="UninstallButton" Content="{DynamicResource Install_Uninstall}" Width="120" Height="32"
                    Margin="0,0,10,0" Click="UninstallButton_Click" Style="{StaticResource SecondaryButton}"/>
            <Button Grid.Column="2" Name="CancelButton" Content="{DynamicResource Install_Cancel}" Width="120" Height="32"
                    Margin="0,0,10,0" Click="CancelButton_Click" Style="{StaticResource SecondaryButton}"/>
            <Button Grid.Column="3" Name="NextButton" Width="120" Height="32"
                    Click="NextButton_Click" Style="{StaticResource PrimaryButton}"/>
            </Grid>
        </Grid>
    </Border>
</Window>
