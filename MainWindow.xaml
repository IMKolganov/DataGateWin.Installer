<Window x:Class="DataGateWin.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DataGate Installer" Height="520" Width="860"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="DataGate Windows Installer"
                   FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Zip URL:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox Grid.Column="1" Name="UrlTextBox" Height="28" IsReadOnly="True"
                     Text="https://example.com/datagatewin.zip"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Install folder:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox Grid.Column="1" Name="InstallPathTextBox" Height="28"/>
            <Button Grid.Column="2" Name="BrowseButton" Content="Browse..." Width="110" Height="28"
                    Margin="10,0,0,0" Click="BrowseButton_Click"/>
        </Grid>

        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ProgressBar Grid.Column="0" Grid.ColumnSpan="2" Name="ProgressBar"
                         Height="22" Minimum="0" Maximum="100" Value="0" />

            <Button Grid.Column="2" Name="InstallButton" Content="Install" Width="120" Height="32"
                    Margin="10,0,0,0" Click="InstallButton_Click"/>
            <Button Grid.Column="3" Name="UninstallButton" Content="Uninstall" Width="120" Height="32"
                    Margin="10,0,0,0" Click="UninstallButton_Click"/>
        </Grid>

        <TextBox Grid.Row="4" Name="LogTextBox"
                 IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="12"/>
    </Grid>
</Window>
