<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <UseWindowsForms>true</UseWindowsForms>
        <ApplicationIcon>Images\favicon.ico</ApplicationIcon>
        <AssemblyVersion>1.0.24</AssemblyVersion>
        <FileVersion>1.0.24</FileVersion>
        <Product>DataGate</Product>
        <AssemblyTitle>DataGate</AssemblyTitle>
        <Description>DataGate</Description>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <PublishSingleFile>true</PublishSingleFile>
        <SelfContained>true</SelfContained>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\DataGateWin.Core\DataGateWin.Core.csproj"/>
        <ProjectReference Include="..\DataGateWin.CrashReporting\DataGateWin.CrashReporting.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="DataGateWin.Tests"/>
    </ItemGroup>

    <!-- Installer is WPF; it shares the UI string dictionaries. The UI files use x:String (WinUI),
         WPF needs sys:String, so convert them into obj\ at build time. -->
    <Target Name="GenerateInstallerStrings" BeforeTargets="MarkupCompilePass1">
        <ItemGroup>
            <_UiStringsSrc Include="$(MSBuildThisFileDirectory)..\DataGateWin.UI\Localization\Strings.*.xaml"/>
        </ItemGroup>
        <MakeDir Directories="$(IntermediateOutputPath)GeneratedStrings"/>
        <WriteLinesToFile File="$(IntermediateOutputPath)GeneratedStrings\%(_UiStringsSrc.Filename)%(_UiStringsSrc.Extension)"
                          Lines="$([System.IO.File]::ReadAllText('%(_UiStringsSrc.FullPath)').Replace('&lt;x:String ', '&lt;sys:String ').Replace('&lt;/x:String&gt;', '&lt;/sys:String&gt;').Replace('&lt;ResourceDictionary ', '&lt;ResourceDictionary xmlns:sys=&quot;clr-namespace:System%3Bassembly=System.Runtime&quot; '))"
                          Overwrite="true" WriteOnlyWhenDifferent="true"/>
        <ItemGroup>
            <_GenStrings Include="$(IntermediateOutputPath)GeneratedStrings\Strings.*.xaml"/>
            <Page Remove="@(_GenStrings)"/>
            <Page Include="@(_GenStrings)" Link="Localization\%(Filename)%(Extension)"/>
        </ItemGroup>
    </Target>

</Project>
