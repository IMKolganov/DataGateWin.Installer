<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <UseWindowsForms>true</UseWindowsForms>
        <ApplicationIcon>Images\favicon.ico</ApplicationIcon>
        <AssemblyVersion>1.0.13</AssemblyVersion>
        <FileVersion>1.0.13</FileVersion>
        <Product>DataGate</Product>
        <AssemblyTitle>DataGate</AssemblyTitle>
        <Description>DataGate</Description>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <PublishSingleFile>true</PublishSingleFile>
        <SelfContained>true</SelfContained>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\DataGateWin.Core\DataGateWin.Core.csproj"/>
        <ProjectReference Include="..\DataGateWin.CrashReporting\DataGateWin.CrashReporting.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="DataGateWin.Tests"/>
    </ItemGroup>

    <ItemGroup>
        <!-- Installer is WPF: keep sys:String dictionaries from legacy UI (WinUI uses x:String). -->
        <Page Include="..\DataGateWin.UI\Localization\Strings.*.xaml" Link="Localization\%(Filename)%(Extension)"/>
    </ItemGroup>

</Project>
